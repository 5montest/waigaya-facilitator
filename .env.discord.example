# 秘密値はチャットに送らない。このファイルを .env.discord へコピーして設定する。
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Botトークンは値だけを1行で別ファイルへ保存。
DISCORD_BOT_TOKEN_FILE=seacret/discord-token.txt
WAIGAYA_DISCORD_SERVER=http://127.0.0.1:8765

# npm run discord:auth で生成。サーバー側の .env.local にも同じパスを設定。
WAIGAYA_DISCORD_SERVICE_TOKEN_FILE=seacret/discord-service-token.txt
# 任意。会議の管理担当として許可するロールIDをカンマ区切り。
WAIGAYA_DISCORD_CONTROL_ROLE_IDS=
