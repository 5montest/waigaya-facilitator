# 実際の値はチャットに貼らず、ローカルの .env.local に設定する。
OPENAI_API_KEY=
# キーを複製せず、承認した既存ファイルから読む場合はこちらを指定。
OPENAI_API_KEY_FILE=
# 議事録の生成はローカルのAnthropic互換ブリッジ経由のGLMを使う（OpenAI不要・追加課金なし）。
# ANTHROPIC_API_KEYにブリッジのキー、ANTHROPIC_BASE_URLにブリッジのURLを設定する。
# 未設定時はhttp://127.0.0.1:7684/v1/messagesへ接続する。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
WAIGAYA_OPENAI_VOICE=marin
WAIGAYA_PORT=8765
# LANへ公開する場合は、許可するホストとクライアントのサブネットも指定。
WAIGAYA_HOST=127.0.0.1
WAIGAYA_ALLOWED_HOSTS=
WAIGAYA_ALLOWED_NETWORKS=
# 別端末のマイクにはHTTPSを使用。秘密鍵と証明書はサーバーに保存。
WAIGAYA_HTTPS_PORT=8766
WAIGAYA_HTTPS_URL=
WAIGAYA_TLS_KEY=
WAIGAYA_TLS_CERT=
WAIGAYA_TLS_CA=

# Discord利用時のみ。npm run discord:auth で用意し、Bot側と同じファイルを指定。
WAIGAYA_DISCORD_SERVICE_TOKEN_FILE=

# 任意：Discord固定運用。Botと同じ値を設定するとサーバー起動時にも構造検証する。
# 未設定時はログイン後の認証済みBotが固定方針を登録（Discord上の実在・権限検査はBotが実施）。
DISCORD_GUILD_ID=
WAIGAYA_DISCORD_VOICE_CHANNEL_ID=
WAIGAYA_DISCORD_MINUTES_FORUM_ID=
WAIGAYA_DISCORD_RESPONSE_POLICY=on_call
WAIGAYA_DISCORD_EMPTY_GRACE_MS=180000
WAIGAYA_DISCORD_AUTO_PUBLISH=true
